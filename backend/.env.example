# --- threat-intel keys (all free tiers) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
# --- MaxMind GeoLite2 (download free .mmdb files from your MaxMind account) ---
GEOLITE_CITY_PATH=data/GeoLite2-City.mmdb
GEOLITE_ASN_PATH=data/GeoLite2-ASN.mmdb
# --- security ---
# chrome-extension://<your-extension-id>  (comma separated). Leave empty to disable CORS.
ALLOWED_ORIGINS=
# If set, clients must send header X-Client-Token: <value>
CLIENT_TOKEN=
# --- tuning ---
VT_PER_MINUTE=4
VT_PER_DAY=500
PROVIDER_TIMEOUT_SECONDS=2.0
