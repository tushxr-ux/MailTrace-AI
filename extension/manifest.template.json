{
  "manifest_version": 3,
  "name": "MailTrace AI",
  "version": "0.1.0",
  "description": "Smarter Email. Safer You. Privacy-first email threat shield — checks who sent it, never reads your email.",
  "icons": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png" },
  "action": {
    "default_title": "MailTrace AI — Protects your inbox",
    "default_icon": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["identity", "storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "__BACKEND_ORIGIN__/*"
  ],
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["assets/icons/*"], "matches": ["https://mail.google.com/*"] }],
  "oauth2": {
    "client_id": "__OAUTH_CLIENT_ID__",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.metadata",
      "https://www.googleapis.com/auth/gmail.labels",
      "https://www.googleapis.com/auth/gmail.settings.basic"
    ]
  }
}
